#!/usr/bin/env bash
# The quality gate. CI runs exactly this, so a green run here is a green pull request.
#
#   scripts/check           every gate below; postgres only when LANTERNIST_TEST_DATABASE_URL is set
#   scripts/check python    format, lint, types, tests (unit, fake pipeline, API, migrations) on SQLite
#   scripts/check postgres  the tests again on Postgres: set LANTERNIST_TEST_DATABASE_URL to an admin URL
#   scripts/check web       format, lint, types and build of the React app
#   scripts/check dup       copy-paste across Python, TypeScript and CSS
#   scripts/check fix       apply the formatters and the safe lint fixes, then stop
#
# Needs `uv sync` and `pnpm --dir web install` first. No GPU, keys or network: engines are faked.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n\033[1m== %s\033[0m\n' "$*"; }

check_python() {
  step "python: format"
  uv run ruff format --check .
  step "python: lint"
  uv run ruff check .
  step "python: types"
  uv run mypy
  step "python: tests"
  env -u LANTERNIST_TEST_DATABASE_URL uv run pytest -q
}

# Only the tests: format, lint and types don't depend on the database.
check_postgres() {
  : "${LANTERNIST_TEST_DATABASE_URL:?set it to a Postgres admin URL, e.g. postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres (README, Develop)}"
  step "python: tests on postgres"
  uv run pytest -q
}

check_web() {
  step "web: format"
  pnpm --dir web run --silent format:check
  step "web: lint"
  pnpm --dir web run --silent lint
  step "web: types and build"
  pnpm --dir web run --silent build
}

check_dup() {
  step "duplication"
  web/node_modules/.bin/jscpd --config .jscpd.json src web/src tests
}

fix() {
  uv run ruff format .
  uv run ruff check --fix .
  pnpm --dir web run --silent format
  pnpm --dir web run --silent lint --fix
}

# Plain `;` sequences, never `a && b`: bash ignores `set -e` inside a function called on the left of
# `&&`, which would let a failing gate pass.
case "${1:-all}" in
  all)
    check_python
    if [[ -n "${LANTERNIST_TEST_DATABASE_URL:-}" ]]; then
      check_postgres
    else
      step "python: tests on postgres: skipped, LANTERNIST_TEST_DATABASE_URL isn't set (CI runs them)"
    fi
    check_web; check_dup; step "all checks passed" ;;
  python) check_python ;;
  postgres) check_postgres ;;
  web) check_web ;;
  dup) check_dup ;;
  fix) fix ;;
  *) echo "usage: scripts/check [all|python|postgres|web|dup|fix]" >&2; exit 2 ;;
esac
