{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check)",
      "Bash(scripts/check *)",
      "Bash(uv sync)",
      "Bash(uv run pytest)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy)",
      "Bash(uv run lanternist schema)",
      "Bash(uv run lanternist doctor)",
      "Bash(pnpm --dir web install)",
      "Bash(pnpm --dir web run *)",
      "Bash(pnpm --dir web exec prettier *)",
      "Bash(pnpm --dir web exec eslint *)",
      "Bash(pnpm --dir web exec tsc *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(uv run pytest *live*)",
      "Bash(uv run pytest *gpu*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
